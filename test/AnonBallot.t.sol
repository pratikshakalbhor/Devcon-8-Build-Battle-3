pragma solidity ^0.8.28;

import {Test} from "forge-std/Test.sol";
import {Vm} from "forge-std/Vm.sol";

import {AnonBallot} from "../src/AnonBallot.sol";
import {ISemaphore} from "@semaphore-protocol/contracts/interfaces/ISemaphore.sol";
import {Semaphore} from "@semaphore-protocol/contracts/Semaphore.sol";
import {SemaphoreVerifier} from "@semaphore-protocol/contracts/base/SemaphoreVerifier.sol";
import {ISemaphoreVerifier} from "@semaphore-protocol/contracts/interfaces/ISemaphoreVerifier.sol";

/// @notice Contract tests for AnonBallot using the REAL Semaphore V4 contracts and
///         REAL Groth16 proofs generated by the `semaphore-protocol/core` package.
///
/// PROOF FIXTURES - how they were made
/// ------------------------------------
/// `test/fixtures/anonballot.vectors.json` is produced by `scripts/generate-fixtures.ts`
/// (`npm run fixtures`). Identities come from the public seed `anvote-fixture-v1/...`,
/// groups are LeanIMT groups built from those commitments, and every proof is produced by
/// `generateProof()` from the `semaphore-protocol/core` package. Only public values are stored.
///
/// WHY THE CONTRACT IS ETCHED AT A FIXED ADDRESS
/// ---------------------------------------------
/// The ballot scope commits to `address(this)` (`keccak256(abi.encode(address(this), ballotId))`),
/// so the scope - and therefore every proof - depends on the AnonBallot address. To keep the
/// committed vectors valid across runs, `setUp` deploys AnonBallot normally and then moves its
/// runtime code (which already contains the `semaphore` immutable) onto the fixed address
/// below with `vm.etch`. Storage at that address starts empty, exactly like a fresh deployment.
/// This is a test-only convenience; nothing in `src/AnonBallot.sol` depends on it.
contract AnonBallotTest is Test {
    /// @dev Fixed address AnonBallot is etched onto; must match `BALLOT_ADDRESS` in the fixture.
    address internal constant FIXED_BALLOT_ADDRESS = 0x000000000000000000000000000000000000a11c;

    string internal constant FIXTURE_PATH = "test/fixtures/anonballot.vectors.json";
    uint256 internal constant STRIDE = 13; // depth, root, nullifier, message, scope, points[0..7]
    uint256 internal constant VOTERS = 38;

    Semaphore internal semaphore;
    AnonBallot internal ballot;

    string internal json;
    string[] internal flat;
    uint256[] internal members;

    function setUp() public {
        json = vm.readFile(FIXTURE_PATH);
        assertTrue(vm.parseJsonUint(json, ".stride") == STRIDE, "fixture: bad stride");

        flat = vm.parseJsonStringArray(json, ".proofsFlat");
        assertTrue(flat.length % STRIDE == 0, "fixture: bad proofsFlat length");

        string[] memory memberStrings = vm.parseJsonStringArray(json, ".members");
        assertTrue(memberStrings.length == VOTERS, "fixture: bad member count");
        members = new uint256[](VOTERS);
        for (uint256 i; i < VOTERS; i += 1) {
            members[i] = _dec(memberStrings[i]);
        }

        // --- real Semaphore V4 contracts, deployed exactly as the package ships them ---
        SemaphoreVerifier verifier = new SemaphoreVerifier();
        semaphore = new Semaphore(ISemaphoreVerifier(address(verifier)));

        // --- AnonBallot, moved to the fixed address (see contract-level note) ---
        AnonBallot deployable = new AnonBallot(address(semaphore));
        vm.etch(FIXED_BALLOT_ADDRESS, address(deployable).code);
        ballot = AnonBallot(FIXED_BALLOT_ADDRESS);

        // --- three ballots; ids 0, 1, 2 are therefore deterministic ---
        uint64 open = uint64(block.timestamp + 30 days);
        uint64 soon = uint64(block.timestamp + 1 hours);
        ballot.createBallot("Which shift pattern should the ward adopt?", 3, open); // id 0
        ballot.createBallot("Which canteen menu next month?", 2, open); // id 1
        ballot.createBallot("Should we raise the staffing level?", 2, soon); // id 2

        // createBallot was called by this test contract, so this contract is the
        // Semaphore group admin of every ballot's group - membership lives there.
        _addMembers(0, members); //            same order as the JS group -> same root
        _addMembers(1, _reversed(members)); // reversed -> a genuinely different root
        _addMembers(2, members);

        // sanity: the on-chain roots must equal the roots the proofs were made against
        assertEq(_root(0), _fixtureUint(".roots.A"), "root A mismatch");
        assertEq(_root(1), _fixtureUint(".roots.B"), "root B mismatch");
        assertEq(_root(2), _fixtureUint(".roots.C"), "root C mismatch");
        assertEq(_scope(0), _fixtureUint(".scopes.A"), "scope A mismatch");
        assertEq(_scope(1), _fixtureUint(".scopes.B"), "scope B mismatch");
        assertEq(_scope(2), _fixtureUint(".scopes.C"), "scope C mismatch");
    }

    // ------------------------------------------------------------------ checks 1-9

    /// @dev Check 1 - one member votes, the tally is updated.
    function test_ValidVoteCounted() public {
        ISemaphore.SemaphoreProof memory proof = _proofAt(_index("valid"));

        vm.recordLogs();
        ballot.castVote(0, proof);
        Vm.Log[] memory logs = vm.getRecordedLogs();

        uint256[] memory tally = ballot.getTally(0);
        assertEq(tally.length, 3, "tally length");
        assertEq(tally[0], 1, "option 0 not counted");
        assertEq(tally[1], 0, "option 1 counted");
        assertEq(tally[2], 0, "option 2 counted");

        // VoteCast(ballotId indexed, option, nullifier) - no voter identity in it
        bytes32 voteCastSig = keccak256("VoteCast(uint256,uint256,uint256)");
        bool seen;
        for (uint256 i; i < logs.length; i += 1) {
            if (logs[i].emitter != address(ballot) || logs[i].topics[0] != voteCastSig) continue;
            seen = true;
            assertEq(uint256(logs[i].topics[1]), 0, "VoteCast ballotId");
            (uint256 option, uint256 nullifier) = abi.decode(logs[i].data, (uint256, uint256));
            assertEq(option, 0, "VoteCast option");
            assertEq(nullifier, proof.nullifier, "VoteCast nullifier");
        }
        assertTrue(seen, "VoteCast not emitted");
    }

    /// @dev Check 2 - the same identity voting twice on the same ballot reverts.
    ///      The two proofs are independently generated but share the identity and the
    ///      scope, so they share the nullifier; Semaphore.validateProof records it.
    function test_SecondVoteFromSameIdentityReverts() public {
        ballot.castVote(0, _proofAt(_index("valid")));

        vm.expectRevert(ISemaphore.Semaphore__YouAreUsingTheSameNullifierTwice.selector);
        ballot.castVote(0, _proofAt(_index("doubleVote")));

        uint256[] memory tally = ballot.getTally(0);
        assertEq(tally[0], 1, "first vote lost");
        assertEq(tally[1], 0, "second vote counted");
    }

    /// @dev Check 3 - a proof scoped to ballot B cannot be spent on ballot A.
    function test_ProofFromOtherBallotReverts() public {
        ISemaphore.SemaphoreProof memory proof = _proofAt(_index("otherBallot"));
        assertEq(proof.scope, _scope(1), "fixture: proof is not scoped to ballot 1");

        vm.expectRevert(AnonBallot.ScopeMismatch.selector);
        ballot.castVote(0, proof);

        assertEq(ballot.getTally(0)[1], 0, "foreign-scope vote counted");
    }

    /// @dev Check 4 - votes after closesAt are rejected.
    function test_ClosedBallotReverts() public {
        uint64 closesAt = ballot.getBallot(2).closesAt;
        vm.warp(uint256(closesAt) + 1);

        vm.expectRevert(AnonBallot.BallotClosed.selector);
        ballot.castVote(2, _proofAt(_index("closedBallot")));

        assertEq(ballot.getTally(2)[1], 0, "closed-ballot vote counted");
    }

    /// @dev Check 5 - an identity that is not in the ballot's group cannot vote.
    ///      The outsider proves membership of its own group; the Merkle root therefore
    ///      is not a root of this ballot's group and Semaphore rejects it.
    function test_NonMemberReverts() public {
        ISemaphore.SemaphoreProof memory proof = _proofAt(_index("nonMember"));
        assertEq(proof.scope, _scope(0), "fixture: proof must carry ballot 0's scope");
        assertTrue(proof.merkleTreeRoot != _root(0), "fixture: outsider root must differ");

        vm.expectRevert(ISemaphore.Semaphore__MerkleTreeRootIsNotPartOfTheGroup.selector);
        ballot.castVote(0, proof);

        assertEq(ballot.getTally(0)[0], 0, "non-member vote counted");
    }

    /// @dev Check 6 - message >= optionCount is rejected before any validation.
    function test_OptionOutOfRangeReverts() public {
        ISemaphore.SemaphoreProof memory proof = _proofAt(_index("outOfRange"));
        assertTrue(proof.message >= ballot.getBallot(0).optionCount, "fixture: message must be out of range");

        vm.expectRevert(AnonBallot.OptionOutOfRange.selector);
        ballot.castVote(0, proof);

        assertEq(ballot.getTally(0).length, 3, "tally changed");
    }

    /// @dev Check 7 - the sender of the transaction is irrelevant: an unrelated address
    ///      (the relayer) can submit a member's proof and the vote still counts.
    function test_MsgSenderIrrelevant() public {
        address relayer = address(0xB0B);
        ISemaphore.SemaphoreProof memory proof = _proofAt(_index("relayer"));

        vm.prank(relayer);
        ballot.castVote(0, proof);

        uint256[] memory tally = ballot.getTally(0);
        assertEq(tally[2], 1, "relayed vote not counted");
        assertEq(tally[0] + tally[1] + tally[2], 1, "wrong total");
    }

    /// @dev Check 8 - 38 identities vote with mixed choices: the tally equals the
    ///      expected counts and every nullifier is used exactly once.
    function test_TallyMatchesVotes() public {
        uint256 base = _index("tally38");
        uint256[] memory nullifiers = new uint256[](VOTERS);

        for (uint256 i; i < VOTERS; i += 1) {
            ISemaphore.SemaphoreProof memory proof = _proofAt(base + i);
            assertEq(proof.message, i % 3, "fixture: unexpected message");
            ballot.castVote(0, proof);
            nullifiers[i] = proof.nullifier;
        }

        uint256[] memory tally = ballot.getTally(0);
        uint256[] memory expected = new uint256[](3);
        expected[0] = 13;
        expected[1] = 13;
        expected[2] = 12;
        assertEq(tally, expected, "tally mismatch");

        uint256 total;
        for (uint256 i; i < tally.length; i += 1) total += tally[i];
        assertEq(total, VOTERS, "total votes");

        // each identity voted exactly once: nullifiers are unique
        for (uint256 i; i < VOTERS; i += 1) {
            for (uint256 j = i + 1; j < VOTERS; j += 1) {
                assertTrue(nullifiers[i] != nullifiers[j], "duplicate nullifier");
            }
        }
    }

    /// @dev Check 9 (optional) - the same message value on two different ballots produces
    ///      two independent tallies, and the two nullifiers differ because the scopes differ.
    function test_SameMessageDifferentBallotIndependent() public {
        ISemaphore.SemaphoreProof memory onA = _proofAt(_index("doubleVote")); // message 1, scope A
        ISemaphore.SemaphoreProof memory onB = _proofAt(_index("otherBallot")); // message 1, scope B

        assertEq(onA.message, onB.message, "fixture: same message expected");
        assertTrue(onA.nullifier != onB.nullifier, "nullifiers must differ per scope");

        ballot.castVote(0, onA);
        ballot.castVote(1, onB);

        assertEq(ballot.getTally(0)[1], 1, "ballot A tally");
        assertEq(ballot.getTally(1)[1], 1, "ballot B tally");
        assertEq(ballot.getTally(0)[0], 0, "ballot A contaminated");
        assertEq(ballot.getTally(1)[0], 0, "ballot B contaminated");
    }

    // ------------------------------------------------------- supporting assertions

    /// @dev The scope is derived only from contract state, exactly as specified.
    function test_ScopeDerivedOnlyFromContractState() public {
        for (uint256 id; id < 3; id += 1) {
            uint256 expected = uint256(keccak256(abi.encode(address(ballot), id)));
            assertEq(_scope(id), expected, "scope not derived from (address(this), ballotId)");
        }
    }

    /// @dev AnonBallot holds no membership API: it has no fallback, so membership-style
    ///      selectors are rejected, and the only Semaphore handle it exposes is the real one.
    function test_AnonBallotExposesNoMembershipFunctions() public {
        assertEq(address(ballot.semaphore()), address(semaphore), "wrong semaphore handle");

        // AnonBallot has no fallback function, so any selector it does not declare reverts.
        (bool ok,) = address(ballot).call(abi.encodeWithSignature("addMember(uint256,uint256)"));
        assertTrue(!ok, "AnonBallot must not accept addMember");
        (ok,) = address(ballot).call(abi.encodeWithSignature("addMembers(uint256,uint256[])"));
        assertTrue(!ok, "AnonBallot must not accept addMembers");
        (ok,) = address(ballot).call(abi.encodeWithSignature("removeMember(uint256,uint256)"));
        assertTrue(!ok, "AnonBallot must not accept removeMember");
        (ok,) = address(ballot).call(abi.encodeWithSignature("transferOwnership(address)"));
        assertTrue(!ok, "AnonBallot must not accept transferOwnership");
    }

    // ---------------------------------------------------------------------- helpers

    function _addMembers(uint256 ballotId, uint256[] memory commitments) internal {
        semaphore.addMembers(ballot.getBallot(ballotId).groupId, commitments);
    }

    function _root(uint256 ballotId) internal view returns (uint256) {
        return semaphore.getMerkleTreeRoot(ballot.getBallot(ballotId).groupId);
    }

    function _scope(uint256 ballotId) internal view returns (uint256) {
        return ballot.getBallot(ballotId).scope;
    }

    function _index(string memory name) internal view returns (uint256) {
        return vm.parseJsonUint(json, string.concat(".proofIndex.", name));
    }

    function _fixtureUint(string memory key) internal view returns (uint256) {
        return _dec(vm.parseJsonString(json, key));
    }

    /// @dev Rebuilds an `ISemaphore.SemaphoreProof` from the flattened fixture.
    function _proofAt(uint256 blockIndex) internal view returns (ISemaphore.SemaphoreProof memory proof) {
        uint256 b = blockIndex * STRIDE;
        proof.merkleTreeDepth = _dec(flat[b]);
        proof.merkleTreeRoot = _dec(flat[b + 1]);
        proof.nullifier = _dec(flat[b + 2]);
        proof.message = _dec(flat[b + 3]);
        proof.scope = _dec(flat[b + 4]);
        for (uint256 i; i < 8; i += 1) {
            proof.points[i] = _dec(flat[b + 5 + i]);
        }
    }

    function _reversed(uint256[] memory values) internal pure returns (uint256[] memory out) {
        out = new uint256[](values.length);
        for (uint256 i; i < values.length; i += 1) {
            out[i] = values[values.length - 1 - i];
        }
    }

    /// @dev Parses a base-10 string. The fixture stores big integers as strings because
    ///      JSON numbers cannot hold 256-bit values losslessly.
    function _dec(string memory text) internal pure returns (uint256 value) {
        bytes memory raw = bytes(text);
        for (uint256 i; i < raw.length; i += 1) {
            uint8 c = uint8(raw[i]);
            if (c < 48 || c > 57) revert("fixture: not a decimal string");
            value = value * 10 + (c - 48);
        }
    }
}
