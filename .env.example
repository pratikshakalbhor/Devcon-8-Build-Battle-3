# ---------------------------------------------------------------------------
# AnonVote - example environment file. PLACEHOLDERS ONLY. Copy to `.env`.
# Never commit a real `.env`: it is gitignored.
# ---------------------------------------------------------------------------

# JSON-RPC endpoint used by the client for reads and (via the relayer) writes.
# Use a local Anvil node for development. Do NOT put an authenticated/secret
# RPC URL here if this file is ever shared.
RPC_URL=http://127.0.0.1:8545

# Chain id of that endpoint (31337 for a default Anvil node).
CHAIN_ID=31337

# Address of the deployed `Semaphore` contract (from @semaphore-protocol/contracts).
SEMAPHORE_ADDRESS=0x0000000000000000000000000000000000000000

# Address of the deployed `AnonBallot` contract.
ANONBALLOT_ADDRESS=0x0000000000000000000000000000000000000000

# Address that creates ballots and administers group membership
# (the "Priya / ward admin" role).
ADMIN_ADDRESS=0x0000000000000000000000000000000000000000

# Relayer account that actually broadcasts `castVote` transactions.
# Leave blank to fall back to Anvil's development account #1, which only works
# against a local Anvil node started with its default configuration.
RELAYER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
# The next line is commented out on purpose. For a LOCAL demo only, copy it into
# the gitignored `.env` and uncomment it. It is Anvil's publicly known
# development key #1 (it holds no real funds):
# RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
RELAYER_PRIVATE_KEY=

# Directory (relative to repo root) where a nurse's local identity is stored.
# `identity*.json` is gitignored.
IDENTITY_FILE=identity.nurse.json

# File holding the list of identity commitments for a group (admin side).
# `votes*.json` is gitignored.
COMMITMENTS_FILE=votes.commitments.json
